PORT=5000
NODE_ENV=development

# Allowed browser origin(s), comma separated
CLIENT_ORIGIN=http://localhost:5173

# MongoDB (local or Atlas connection string)
MONGODB_URI=mongodb://127.0.0.1:27017/dreamverse

# REQUIRED for register/login. Use a long random string (16+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# bcrypt cost factor (higher = slower and safer). 12 is a good default.
BCRYPT_ROUNDS=12

# AI provider (any OpenAI-compatible endpoint hosting an open-weight model).
# Leave AI_API_KEY empty to run in clearly labeled demo mode.
# All three must be set for live AI. Other providers: Groq https://api.groq.com/openai/v1,
# OpenRouter https://openrouter.ai/api/v1, local Ollama http://localhost:11434/v1 (any non-empty key).
# Check your provider's model list for the exact AI_MODEL id.
AI_BASE_URL=https://api.together.xyz/v1
AI_API_KEY=
AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
# Optional tuning
# AI_TIMEOUT_MS=30000
# AI_MAX_TOKENS=1800
# Set to false if your provider rejects strict JSON mode
# AI_JSON_MODE=true
# Max AI requests per signed-in user per 15 minutes
# AI_RATE_LIMIT=30

# Game balance: XP per daily-streak day (day 1 = 1 step, up to 5 steps). 0 turns the bonus off.
# STREAK_STEP_XP=5

# Optional: run the database integration tests (database name must contain "test"; it is wiped!)
# TEST_MONGODB_URI=mongodb://127.0.0.1:27017/dreamverse_test

# Deployment: when the API runs behind a hosting proxy (Render, Railway, Fly, ...), set this to 1
# so rate limiting sees each visitor's real address. Leave unset on your own computer.
# TRUST_PROXY=1

# --- Password reset email ---------------------------------------------------------------
# The website address used inside reset emails. Defaults to the first CLIENT_ORIGIN.
# APP_URL=http://localhost:5173
#
# Leave the two lines below empty while developing: no email is sent, and the reset link is
# printed in this server's terminal instead.
# To send real email, use Brevo (free plan, works over HTTPS so it also works on hosts that block
# SMTP): create an account, make an API key under SMTP & API > API Keys, and verify the sender
# address under Senders. Then fill in both lines:
# BREVO_API_KEY=your-brevo-api-key
# MAIL_FROM=DreamVerse AI <your-verified-sender@example.com>
